        }
      },
      "title": "SourcedLugSpacing",
      "type": "object"
    },
    "SourcedPlate": {
      "additionalProperties": false,
      "description": "A sourced plate type.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Plate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
